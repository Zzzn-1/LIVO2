  // 新增：帧同步相关变量
  struct FramePair {
    cv::Mat img_rgb;
    cv::Mat img_setic;
    double timestamp_rgb;
    double timestamp_setic;
    bool has_rgb;
    bool has_setic;
    double sync_tolerance;
    
    FramePair() : has_rgb(false), has_setic(false), sync_tolerance(0.01) {}
    
    bool isComplete() const { return has_rgb && has_setic; }
    
    bool isTimeMatched() const { 
      return has_rgb && has_setic && 
             std::abs(timestamp_rgb - timestamp_setic) < sync_tolerance; 
    }
    
    double getTimeDiff() const {
      if (!has_rgb || !has_setic) return 1000.0;
      return std::abs(timestamp_rgb - timestamp_setic);
    }
  };
  
